# Скопируйте в .env.local и заполните из Firebase Console → Project settings → Your apps → Web app.
# Если оставить пустым — приложение работает локально (данные в localStorage браузера).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Модели Gemini для Firebase AI Logic (пусто — встроенные цепочки с запасными моделями, см. src/lib/gemini.ts)
# Чат в документах:
VITE_GEMINI_MODEL=gemini-3.8-flash
# Подбор замен в схемах и разбор ресурсов:
VITE_GEMINI_FAST_MODEL=gemini-3.5-flash-lite

# App Check (reCAPTCHA Enterprise site key; пусто — App Check выключен)
VITE_RECAPTCHA_SITE_KEY=
