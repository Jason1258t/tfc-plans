# Скопируйте в .env.local и заполните из Firebase Console → Project settings → Your apps → Web app.
# Если оставить пустым — приложение работает локально (данные в localStorage браузера).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Модель Gemini для Firebase AI Logic
VITE_GEMINI_MODEL=gemini-2.5-flash
