rules_version = '2';

// Настоящей авторизации нет: ник — это подпись, хранится в куке.
// Приложение входит анонимно, поэтому требуем request.auth != null —
// это отсекает голые запросы к REST API без SDK, но не является защитой от «своих».
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function nick(v) {
      return v is string && v.size() >= 2 && v.size() <= 24;
    }

    match /tasks/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 300
        && nick(request.resource.data.author)
        && request.resource.data.checklist is list
        && request.resource.data.checklist.size() <= 500;
      allow update: if signedIn()
        && request.resource.data.author == resource.data.author
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 300
        && request.resource.data.checklist.size() <= 500;
      allow delete: if signedIn();
    }

    match /groups/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40;
      allow delete: if signedIn();
    }

    // Общие настройки сайта: settings/world — профиль и масштаб мира TFC Real World для карты
    match /settings/{id} {
      allow read: if signedIn();
      allow write: if signedIn()
        && id == 'world'
        && request.resource.data.profile is string
        && request.resource.data.profile.size() <= 100
        && (request.resource.data.horizontalScale == null || (request.resource.data.horizontalScale is int
            && request.resource.data.horizontalScale > 0 && request.resource.data.horizontalScale <= 1000000))
        && (request.resource.data.verticalScale == null || (request.resource.data.verticalScale is int
            && request.resource.data.verticalScale > 0 && request.resource.data.verticalScale <= 1000000))
        && request.resource.data.verified is bool
        && nick(request.resource.data.updatedBy);
    }

    // Обновления сборки: создаёт scripts/pack-release.mjs при деплое (от имени CLI, мимо правил).
    // С сайта можно только записать/поправить патчноут (поле notes).
    match /packUpdates/{id} {
      allow read: if signedIn();
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes'])
        && request.resource.data.notes.body is string
        && request.resource.data.notes.body.size() <= 30000
        && request.resource.data.notes.source in ['agent', 'manual']
        && nick(request.resource.data.notes.updatedBy);
    }

    // Вложения задач — пакет firestore-files, конфиг src/lib/files.config.ts.
    // Блок ниже генерируется: npm run rules:files
    // firestore-files:begin files
    // Generated by firestore-files — do not edit by hand, regenerate with: npx firestore-files rules
    // maxFileSize=26214400 chunkSize=716800 maxChunks=37 owner=false
    match /files/{fileId} {
      function ffValidNew() {
        let d = request.resource.data;
        return d.keys().hasAll(['name', 'size', 'type', 'chunks', 'complete', 'createdAt'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 255
          && d.type is string && d.type.size() <= 255
          && d.size is int && d.size >= 0 && d.size <= 26214400
          && d.chunks is int && d.chunks >= 1 && d.chunks <= 37
          && d.size <= d.chunks * 716800
          && (d.chunks == 1 || d.size > (d.chunks - 1) * 716800)
          && d.complete == false
          && d.createdAt is int
          && (!('sha256' in d) || (d.sha256 is string && d.sha256.size() == 64));
      }
      function ffParentPath() {
        return /databases/$(database)/documents/files/$(fileId);
      }
      function ffParent() {
        return get(ffParentPath()).data;
      }

      allow read: if signedIn();
      allow create: if (signedIn()) && ffValidNew() && (nick(request.resource.data.author) && (request.resource.data.taskId == null || request.resource.data.taskId is string));
      // The only allowed update — marking "all chunks written"
      allow update: if (signedIn())
        && resource.data.complete == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['complete'])
        && request.resource.data.complete == true;
      allow delete: if signedIn();

      match /chunks/{n} {
        allow read: if signedIn();
        // Chunks go only into an incomplete file, under their own index and no larger than chunkSize
        allow create: if (signedIn())
          && ffParent().complete == false
          && request.resource.data.keys().hasOnly(['i', 'data'])
          && request.resource.data.i is int
          && request.resource.data.i >= 0
          && request.resource.data.i < ffParent().chunks
          && n == string(request.resource.data.i)
          && request.resource.data.data is bytes
          && request.resource.data.data.size() <= 716800;
        // Orphaned chunks (metadata already deleted) can be removed by anyone
        allow delete: if !exists(ffParentPath()) || signedIn();
      }
    }
    // firestore-files:end files

    // Подсказки по типам рецептов: первичное наполнение — scripts/seed-recipe-hints.mjs,
    // дальше правят люди и агент с сайта
    match /recipeHints/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.type is string
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 20000
        && request.resource.data.source in ['agent', 'manual', 'claude']
        && nick(request.resource.data.updatedBy);
      allow delete: if signedIn();
    }

    // Черновики датапаков: файлы хранятся текстом внутри документа
    match /datapacks/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.entries is list
        && request.resource.data.entries.size() <= 300
        && (!('install' in request.resource.data) || request.resource.data.install is bool)
        && nick(request.resource.data.updatedBy);
      allow delete: if signedIn();
    }

    // Скрипты KubeJS (kubejs/server_scripts/): текст внутри документа, «Ставить на сервер» — install
    match /kubejsScripts/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.fileName is string
        && request.resource.data.fileName.matches('[a-z0-9_][a-z0-9_.-]{0,79}[.]js')
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 200000
        && (!('install' in request.resource.data) || request.resource.data.install is bool)
        && nick(request.resource.data.updatedBy);
      allow delete: if signedIn();
    }

    // Конфиги модов с сервера/инстанса — пишет только scripts/import-config.mjs (от имени владельца проекта)
    match /config/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Библиотека схем: исходник — в files/{fileId}, здесь имя и замены
    match /schematics/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.fileId is string
        && request.resource.data.replace is list
        && request.resource.data.replace.size() <= 2000
        && (!('preview' in request.resource.data)
          || (request.resource.data.preview is string && request.resource.data.preview.size() <= 300000))
        && (!('description' in request.resource.data)
          || (request.resource.data.description is string && request.resource.data.description.size() <= 4000))
        && nick(request.resource.data.updatedBy);
      allow delete: if signedIn();
    }

    match /replaceFavorites/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.from is string
        && request.resource.data.from.size() > 0
        && request.resource.data.from.size() <= 200
        && request.resource.data.to is string
        && request.resource.data.to.size() > 0
        && request.resource.data.to.size() <= 200
        && nick(request.resource.data.updatedBy);
      allow delete: if signedIn();
    }

    // Гайды справочника: правят все, стирать нельзя (снимают с публикации — hidden).
    // Каждое сохранение пишет и версию в revisions — их только добавляют.
    match /guides/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.section is string
        && request.resource.data.section.size() > 0
        && request.resource.data.section.size() <= 40
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.summary is string
        && request.resource.data.summary.size() <= 1000
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 200000
        && (request.resource.data.icon == null || (request.resource.data.icon is string
            && request.resource.data.icon.size() <= 200))
        && request.resource.data.group is string
        && request.resource.data.group.size() <= 80
        && request.resource.data.order is number
        && request.resource.data.checked in ['game', 'server', 'code', 'none']
        && request.resource.data.hidden is bool
        && nick(request.resource.data.updatedBy);
      allow delete: if false;

      match /revisions/{rid} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 200
          && request.resource.data.summary is string
          && request.resource.data.summary.size() <= 1000
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 200000
          && request.resource.data.at is number
          && nick(request.resource.data.updatedBy);
        allow update, delete: if false;
      }
    }

    // Какие подсказки знакомства уже показаны — у каждого анонимного входа (браузера) свой документ, чужие не видны
    match /onboarding/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['seen', 'off', 'updatedAt'])
        && request.resource.data.seen is map
        && request.resource.data.seen.size() <= 100
        && request.resource.data.off is bool
        && request.resource.data.updatedAt is number;
    }

    match /artifacts/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 900000
        && nick(request.resource.data.updatedBy);
      allow delete: if signedIn();
    }

    // Статистика сайта (src/data/analytics.ts): заход пишет и дописывает только его браузер (uid анонимного входа).
    // Старые заходы удаляет TTL-политика по expireAt.
    function visitOk(d) {
      return d.keys().hasOnly(['uid', 'nick', 'startedAt', 'lastAt', 'device', 'events', 'expireAt', 'dev'])
        && nick(d.nick)
        && d.startedAt is number
        && d.lastAt is number
        && d.events is list
        && d.events.size() <= 400
        && d.expireAt is timestamp;
    }
    match /visits/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && visitOk(request.resource.data);
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.startedAt == resource.data.startedAt
        && request.resource.data.expireAt == resource.data.expireAt
        && visitOk(request.resource.data);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Дневные счётчики: id — дата ГГГГ-ММ-ДД (dev-ГГГГ-ММ-ДД — проверки с dev-сервера, их можно удалить)
    match /visitDays/{day} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && day.matches('^(dev-)?[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['visits', 'views', 'actions', 'searches', 'nicks', 'updatedAt'])
        && request.resource.data.updatedAt is number;
      allow delete: if signedIn() && day.matches('^dev-.*');
    }
  }
}
