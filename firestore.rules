rules_version = '2';

// Настоящей авторизации нет: ник — это подпись, хранится в куке.
// Приложение входит анонимно, поэтому требуем request.auth != null —
// это отсекает голые запросы к REST API без SDK, но не является защитой от «своих».
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function nick(v) {
      return v is string && v.size() >= 2 && v.size() <= 24;
    }

    match /tasks/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 300
        && nick(request.resource.data.author)
        && request.resource.data.checklist is list
        && request.resource.data.checklist.size() <= 500;
      allow update: if signedIn()
        && request.resource.data.author == resource.data.author
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 300
        && request.resource.data.checklist.size() <= 500;
      allow delete: if signedIn();
    }

    match /groups/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40;
      allow delete: if signedIn();
    }

    // Вложения: метаданные + содержимое кусками по ~700 КБ (см. src/lib/files.ts)
    match /files/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.size is int
        && request.resource.data.size <= 26214400
        && request.resource.data.chunks is int
        && request.resource.data.chunks <= 40
        && request.resource.data.complete == false
        && nick(request.resource.data.author);
      // Менять можно только флаг готовности
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['complete']);
      allow delete: if signedIn();

      match /chunks/{n} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.data is bytes
          && request.resource.data.data.size() <= 750000
          && request.resource.data.i is int;
        allow delete: if signedIn();
      }
    }

    // Подсказки по типам рецептов: первичное наполнение — scripts/seed-recipe-hints.mjs,
    // дальше правят люди и агент с сайта
    match /recipeHints/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.type is string
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 20000
        && request.resource.data.source in ['agent', 'manual', 'claude']
        && nick(request.resource.data.updatedBy);
      allow delete: if signedIn();
    }

    // Черновики датапаков: файлы хранятся текстом внутри документа
    match /datapacks/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.entries is list
        && request.resource.data.entries.size() <= 300
        && nick(request.resource.data.updatedBy);
      allow delete: if signedIn();
    }

    match /artifacts/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 900000
        && nick(request.resource.data.updatedBy);
      allow delete: if signedIn();
    }
  }
}
