# Настройки сервера сборки. При установке install.sh кладёт их в /etc/tfc-pack.env.

# Где слушать. Наружу смотрит Caddy (HTTPS), сам сервер — только локально.
# Порт не 8787: на той же машине может стоять сервер файлов.
HOST=127.0.0.1
PORT=8788

# Где лежит сборка: blobs/, snapshots/, channels.json, keys.json (бэкап — копия этой папки)
DATA_DIR=/var/lib/tfc-pack

# Лимиты: один файл (1 ГБ), всё хранилище (50 ГБ), сколько места оставлять на диске свободным (1 ГБ)
MAX_BLOB_SIZE=1073741824
MAX_TOTAL_BYTES=53687091200
MIN_FREE_BYTES=1073741824
