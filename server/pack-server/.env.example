# Настройки сервера сборки. При установке install.sh кладёт их в /etc/tfc-pack.env.

# Где слушать. Наружу смотрит Caddy (HTTPS), сам сервер — только локально.
# Порт не 8787: на той же машине может стоять сервер файлов.
HOST=127.0.0.1
PORT=8788

# Где лежит сборка: blobs/, snapshots/, channels.json, keys.json (бэкап — копия этой папки)
DATA_DIR=/var/lib/tfc-pack

# Лимиты: один файл (1 ГБ), всё хранилище (50 ГБ), сколько места оставлять на диске свободным (1 ГБ)
MAX_BLOB_SIZE=1073741824
MAX_TOTAL_BYTES=53687091200
MIN_FREE_BYTES=1073741824

# ---- Сборка данных сайта и публикация (этап 4)
# Сервисный ключ Firebase (роли Cloud Datastore User и Firebase Hosting Admin) — для публикации данных
#GOOGLE_APPLICATION_CREDENTIALS=/etc/tfc-pack/firebase-sa.json

# Код разборщиков: своя копия репозитория в $DATA_DIR/repo (её обновляет «git pull» задания rebuild).
# Сервер, запущенный из репозитория (npm run dev), берёт сам репозиторий и git pull не делает.
#REPO_URL=https://github.com/Jason1258t/tfc-plans.git
#REPO_BRANCH=main

# После смены текущего снимка (POST /pack/current): собрать данные (AUTO_BUILD=off — не собирать)
# и опубликовать: dry-run — только показать, что изменится (по умолчанию); live — выложить; none — не публиковать
#AUTO_BUILD=on
#AUTO_PUBLISH=dry-run

# Лимит кучи процесса сборки, МБ: сборка модов без лимита берёт до ~1,2 ГБ, с 640 — ~0,9 ГБ (меньше 400 — падает)
BUILD_HEAP_MB=640
# Задание дольше этого — останавливается
#JOB_TIMEOUT_MIN=120
