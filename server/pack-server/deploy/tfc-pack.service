[Unit]
Description=Сервер сборки «TFC Studio»
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tfcpack
Group=tfcpack
EnvironmentFile=/etc/tfc-pack.env
WorkingDirectory=/opt/tfc-pack
ExecStart=/usr/bin/node /opt/tfc-pack/server.mjs
Restart=on-failure
RestartSec=3
# SIGTERM получает только сервер: он завершает очередь до выхода.
KillMode=mixed
TimeoutStopSec=infinity

# Песочница: писать можно только в папку данных
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/tfc-pack

[Install]
WantedBy=multi-user.target
