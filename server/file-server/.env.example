# Настройки сервера файлов. При установке install.sh кладёт их в /etc/tfc-files.env.

# Где слушать. Наружу смотрит Caddy (HTTPS), сам сервер — только локально.
HOST=127.0.0.1
PORT=8787

# Где лежат файлы (бэкап — копия этой папки)
DATA_DIR=/var/lib/tfc-files

# Адреса сайта через запятую — с них браузеру разрешено ходить на сервер (CORS)
ALLOWED_ORIGINS=https://tfc-plans-fd2c.web.app,https://tfc-plans-fd2c.firebaseapp.com

# Вход: firebase — проверять ID-токен анонимного входа сайта; none — без проверки (только для опытов)
AUTH=firebase
FIREBASE_PROJECT_ID=tfc-plans-fd2c
# Номер проекта (Firebase Console → Project settings → Project number). Задан — обязателен и токен App Check.
APP_CHECK_PROJECT_NUMBER=340688425515

# Ключ администратора для scripts/files-migrate.mjs (переезд, бэкап). install.sh генерирует его сам.
ADMIN_TOKEN=

# Лимиты: один файл (как maxFileSize в src/lib/files.config.ts), всё хранилище, записей в минуту с пользователя
MAX_FILE_SIZE=26214400
MAX_TOTAL_BYTES=21474836480
WRITES_PER_MINUTE=30

# За Caddy: IP клиента брать из X-Forwarded-For
TRUST_PROXY=1
