{
  "name": "tfc-taskmanager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "prebuild": "node scripts/ensure-items.mjs",
    "predev": "node scripts/ensure-items.mjs",
    "items": "node scripts/build-items.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "firebase deploy",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" scripts/*.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "fflate": "^0.8.3",
    "firebase": "^12.19.0",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.51.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "adm-zip": "^0.6.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
