{
  "name": "tfc-taskmanager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "tfc": "cli/tfc.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "prebuild": "node scripts/ensure-mods.mjs && node scripts/addons-index.mjs && node scripts/freshness.mjs --if-older 6h --soft",
    "predev": "node scripts/ensure-mods.mjs && node scripts/addons-index.mjs && node scripts/freshness.mjs --if-older 6h --soft",
    "mods": "node scripts/mods.mjs",
    "items": "node scripts/mods.mjs",
    "freshness": "node scripts/freshness.mjs",
    "lint": "oxlint src scripts",
    "preview": "vite preview",
    "deploy": "firebase deploy --only firestore,auth && node scripts/deploy-site.mjs",
    "deploy:site": "node scripts/deploy-site.mjs",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "format": "prettier --write",
    "format:check": "prettier --check",
    "rules:files": "firestore-files rules --config src/lib/files.config.ts --write firestore.rules",
    "serverconfig": "node scripts/serverconfig.mjs",
    "config": "node scripts/serverconfig.mjs",
    "kubejs": "node scripts/kubejs.mjs",
    "world": "node scripts/world.mjs",
    "guides": "node scripts/guides.mjs",
    "datapack:pellets": "node scripts/pellet-arc-datapack.mjs",
    "pack": "node scripts/pack.mjs",
    "pack:fetch": "node scripts/pack-fetch.mjs",
    "pack:publish": "node scripts/publish-data.mjs",
    "tfc": "node cli/tfc.mjs",
    "tfc:dist": "node scripts/tfc-dist.mjs",
    "ui:classes": "node scripts/ui/classes.mjs",
    "ui:shots": "node scripts/ui/shots.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/inter": "^5.3.0",
    "@lezer/common": "^1.5.4",
    "cm-live-markdown": "^0.1.4",
    "fflate": "^0.8.3",
    "firebase": "^12.19.0",
    "firestore-files": "^0.1.0",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.51.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "three": "^0.186.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "adm-zip": "^0.6.1",
    "esbuild": "^0.28.2",
    "oxlint": "^1.81.0",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.9.9",
    "smol-toml": "^1.9.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
