        { "wait": 500 },
        {
          "eval": "(async () => { const hasPicker = () => document.body.innerText.includes('Как считать машины'); if (!hasPicker()) { const button = [...document.querySelectorAll('main button')].find((el) => el.textContent.includes('из машин IE…')); if (!button) throw new Error('Кнопка набора нагрузки IE не найдена'); button.click(); } for (let i = 0; i < 50 && !hasPicker(); i++) await new Promise((resolve) => setTimeout(resolve, 100)); if (!hasPicker()) throw new Error('Набор нагрузки IE не открылся'); })()"
