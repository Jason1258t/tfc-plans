    {
      "name": "docs",
      "path": "/docs"
    },
    {
      "name": "docs.dark",
      "path": "/docs",
      "theme": "dark"
    },
    {
      "name": "docs.filter",
      "path": "/docs",
      "actions": [
        {
          "clickText": "Схемы"
        }
      ],
      "note": "выбран вид «Схемы»"
    },
    {
      "name": "docs.search",
      "path": "/docs",
      "actions": [
        {
          "type": ["input[aria-label='Поиск по файлам']", "nbt"]
        }
      ],
      "note": "поиск «nbt»"
