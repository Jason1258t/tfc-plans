{
  "setup": {
    "cookies": {
      "tfc_nick": "ClaudeTest"
    },
    "localStorage": {
      "tfc-onboarding": {
        "seen": {},
        "off": true
      },
      "tfc-tm:updates-seen": "9999999999999"
    },
    "mask": ["header [role=status]"]
  },
  "scenarios": [
    {
      "name": "tasks",
      "path": "/",
      "waitFor": "main"
    },
    {
      "name": "tasks.new-dialog",
      "path": "/",
      "waitFor": "main",
      "actions": [
        {
          "clickText": "Задача"
        },
        {
          "wait": "[role=dialog]"
        }
      ],
      "fullPage": false,
      "note": "окно новой задачи"
    },
    {
      "name": "tasks.group-dialog",
      "path": "/",
      "waitFor": "main",
      "actions": [{ "click": "button[aria-label=\"Новая группа\"]" }, { "wait": "[role=dialog]" }],
      "fullPage": false,
      "note": "окно новой группы"
    },
    {
      "name": "tasks.compare",
      "path": "/",
      "waitFor": "main",
      "actions": [{ "click": "button[title=\"Попарно сравнить задачи по важности\"]" }, { "wait": "[role=dialog]" }],
      "fullPage": false,
      "note": "окно сравнения задач"
    },
    {
      "name": "tasks.dark",
      "path": "/",
      "waitFor": "main",
      "theme": "dark"
    },
    {
      "name": "tasks.new-dialog.dark",
      "path": "/",
      "waitFor": "main",
      "actions": [
        {
          "clickText": "Задача"
        },
        {
          "wait": "[role=dialog]"
        }
      ],
      "fullPage": false,
      "theme": "dark"
    },
    {
      "name": "tasks.nick-dialog",
      "path": "/",
      "waitFor": "main",
      "actions": [{ "click": "header > button" }, { "wait": "[role=dialog]" }],
      "fullPage": false,
      "note": "окно смены ника"
